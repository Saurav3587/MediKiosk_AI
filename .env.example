# MediKiosk Configuration Environment Example
# Copy this file to .env and adjust variables to match your environment

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# Option 1: SQLite (Local development default)
DATABASE_URL=sqlite:///./medikiosk.db

# Option 2: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/medikiosk_db

# Option 3: Cloud PostgreSQL (Supabase, Neon, AWS RDS, etc.)
# DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres

# -------------------------------------------------------------
# Security & JWT
# -------------------------------------------------------------
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------
# AI LLM Provider Configuration
# -------------------------------------------------------------
# Options: sarvam | biomistral | openai | anthropic
LLM_PROVIDER=sarvam
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -------------------------------------------------------------
# Fast2SMS Gateway (SMS to Indian +91 Mobile Phones)
# -------------------------------------------------------------
# Get key from https://www.fast2sms.com -> Dev API
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# -------------------------------------------------------------
# Sarvam AI (Indian Language Voice ASR, TTS & Translation)
# -------------------------------------------------------------
# Sign up at https://dashboard.sarvam.ai -> API Keys
SARVAM_API_KEY=your_sarvam_api_key_here




